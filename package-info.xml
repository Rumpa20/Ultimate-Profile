<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>Rumpa:UltimateProfile</id>
	<name>Ultimate Profile</name>
	<version>1.0</version>
	<type>modification</type>

	<install for="2.1 - 2.1.99">
		<readme parsebbc="true">readme.txt</readme>
		<license type="inline" parsebbc="false">BSD 3-Clause License. Copyright (c) 2026, Rumpa. All rights reserved. Redistribution and use in source and binary forms, with or without modification, are permitted provided the conditions in license.txt are met. THIS SOFTWARE IS PROVIDED "AS IS" WITHOUT WARRANTY OF ANY KIND.</license>
		<database>install.php</database>
		<require-file name="UltimateProfile.php" destination="$sourcedir" />
		<require-file name="UltimateProfile.template.php" destination="$themedir" />
		<require-file name="UltimateProfile.english.php" destination="$languagedir" />
		<require-file name="ultimateprofile.css" destination="$themedir/css" />
		<hook hook="integrate_load_theme" function="UltimateProfile::load_theme" file="$sourcedir/UltimateProfile.php" />
		<hook hook="integrate_profile_areas" function="UltimateProfile::profile_areas" file="$sourcedir/UltimateProfile.php" />
		<hook hook="integrate_general_mod_settings" function="UltimateProfile::general_mod_settings" file="$sourcedir/UltimateProfile.php" />
		<hook hook="integrate_delete_members" function="UltimateProfile::delete_members" file="$sourcedir/UltimateProfile.php" />
	</install>

	<uninstall for="2.1 - 2.1.99">
		<hook hook="integrate_load_theme" function="UltimateProfile::load_theme" file="$sourcedir/UltimateProfile.php" reverse="true" />
		<hook hook="integrate_profile_areas" function="UltimateProfile::profile_areas" file="$sourcedir/UltimateProfile.php" reverse="true" />
		<hook hook="integrate_general_mod_settings" function="UltimateProfile::general_mod_settings" file="$sourcedir/UltimateProfile.php" reverse="true" />
		<hook hook="integrate_delete_members" function="UltimateProfile::delete_members" file="$sourcedir/UltimateProfile.php" reverse="true" />
		<database>uninstall-optional.php</database>
		<remove-file name="$sourcedir/UltimateProfile.php" />
		<remove-file name="$themedir/UltimateProfile.template.php" />
		<remove-file name="$languagedir/UltimateProfile.english.php" />
		<remove-file name="$themedir/css/ultimateprofile.css" />
	</uninstall>
</package-info>
